# Student Mental Health Platform - Environment Variables
# Copy this file to .env in your root and backend folders

# Backend FastAPI Configuration
SECRET_KEY=your-jwt-secret-key-production
ADMIN_SECRET_KEY=your-admin-jwt-secret-key-production
DATABASE_URL=sqlite:///./users.db
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# AI Provider API Key (Google Gemini API)
GEMINI_API_KEY=your_google_gemini_api_key_here

# Frontend Vite Configuration (src / root)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Default admin account (created on first start if it doesn't exist)
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=change-this-admin-password
DEFAULT_ADMIN_NAME=System Admin

# Optional automations (e.g. n8n). Leave blank to disable.
# Every new counselling booking is POSTed here as JSON (fire-and-forget).
BOOKING_WEBHOOK_URL=
# Doctor finder tries this first; if blank or failing it falls back to AI guidance + map search links.
DOCTOR_FINDER_WEBHOOK_URL=
